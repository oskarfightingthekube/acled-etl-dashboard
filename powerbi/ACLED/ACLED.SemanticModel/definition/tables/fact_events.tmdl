table fact_events
	lineageTag: 14fc6ca3-2f4f-5f6e-b77f-a5f2fabbaa1b

	measure 'Total Events' = COUNTROWS(fact_events)
		formatString: #,0
		lineageTag: 5d6b1629-063e-591c-8311-7a5e5da437f5
		displayFolder: Miary

	measure 'Total Fatalities' = SUM(fact_events[fatalities])
		formatString: #,0
		lineageTag: eec24977-d191-53f0-a358-04b41207ada7
		displayFolder: Miary

	measure 'Fatalities per Event' = DIVIDE([Total Fatalities], [Total Events])
		formatString: 0.00
		lineageTag: 6eea8fd6-c2c8-59e6-baf7-9c80a17c910b
		displayFolder: Miary

	measure 'Civilian Targeting Events' = SUM(fact_events[civilian_targeting_flag])
		formatString: #,0
		lineageTag: 81c331c1-de5f-5228-b0bb-395adc1908a5
		displayFolder: Miary

	measure 'Pct Civilian Targeting' = DIVIDE([Civilian Targeting Events], [Total Events])
		formatString: 0.0%
		lineageTag: 916051bf-d63d-53be-b097-8c5e499e4456
		displayFolder: Miary

	measure 'Distinct Actors' = DISTINCTCOUNT(fact_events[id_actor])
		formatString: #,0
		lineageTag: a0dd0a89-9a0a-56fa-8329-2a57db653381
		displayFolder: Miary

	measure 'Distinct Countries' = DISTINCTCOUNT(fact_events[id_country])
		formatString: #,0
		lineageTag: 40392b7f-684e-5183-92eb-ba5b4646b9d5
		displayFolder: Miary

	measure 'Peaceful Protests' = CALCULATE([Total Events], dim_event_type[sub_event_type] = "Peaceful protest")
		formatString: #,0
		lineageTag: ed43a143-a1af-539d-9f2c-15c9535dd11d
		displayFolder: Miary

	measure 'Violent Demonstrations' = CALCULATE([Total Events], dim_event_type[sub_event_type] IN {"Violent demonstration", "Protest with intervention", "Excessive force against protesters"})
		formatString: #,0
		lineageTag: 6b7be6b8-9511-5c9d-8de9-6d842fc062c6
		displayFolder: Miary

	measure 'Peaceful to Violent Ratio' = DIVIDE([Peaceful Protests], [Violent Demonstrations])
		formatString: 0.00
		lineageTag: bcb461e7-d3a8-55d5-a14e-d408b91fd039
		displayFolder: Miary

	measure 'Events LY' = CALCULATE([Total Events], DATEADD(dim_date[date_key], -1, YEAR))
		formatString: #,0
		lineageTag: 067c4727-7e8d-5b77-aabe-e7490efc4f80
		displayFolder: Miary

	measure 'YoY Events %' = DIVIDE([Total Events] - [Events LY], [Events LY])
		formatString: 0.0%
		lineageTag: 0efbf882-3e0d-5739-b8cf-09705f729aca
		displayFolder: Miary

	measure 'Population' = SUM(dim_population_year[population])
		formatString: #,0
		lineageTag: d2c1204a-4eef-5fa1-8f6a-c918e92d8dc1
		displayFolder: Miary

	measure 'Events per 100k' = DIVIDE([Total Events] * 100000, [Population])
		formatString: 0.00
		lineageTag: bb20ff54-d841-5561-8742-c30a30bfb896
		displayFolder: Miary

	measure 'Fatalities per 100k' = DIVIDE([Total Fatalities] * 100000, [Population])
		formatString: 0.00
		lineageTag: 48958ac6-f38d-563a-9c5e-a73220567102
		displayFolder: Miary

