table gold_civilian_region
	lineageTag: 0ae19489-7e3b-5424-92ca-b5093ad4f684

	measure 'Pct Civilian Targeting' = DIVIDE(SUM(gold_civilian_region[civ_targeting_events]), SUM(gold_civilian_region[event_count]))
		formatString: 0.0%
		lineageTag: 12e5d6bc-d936-5367-ab0d-8b597a9f23e7

	column region
		dataType: string
		lineageTag: 7b7711fb-695d-5005-a1e9-5d3050cb118a
		summarizeBy: none
		sourceColumn: region

		annotation SummarizationSetBy = Automatic

	column year
