		lineageTag: 7e3ae59c-c083-5755-828e-b4595b7db2ea
		summarizeBy: sum
		sourceColumn: total_fatalities

		annotation SummarizationSetBy = Automatic

	partition gold_civilian_region = m
		mode: import
		source =
				let
				    Source = AmazonAthena.Databases("ACLED_Athena", null, []),
				    AwsDataCatalog = Source{[Name="AwsDataCatalog",Kind="Database"]}[Data],
				    acled_dev = AwsDataCatalog{[Name="acled_dev",Kind="Schema"]}[Data],
				    gold_civilian_region = acled_dev{[Name="gold_civilian_region",Kind="Table"]}[Data]
				in
				    gold_civilian_region

	annotation PBI_ResultType = Table

